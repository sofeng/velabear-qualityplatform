TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=testhub-fake-remote
CONTAINER_PREFIX=testhub-fake-remote

IMAGE_TAG=latest

MYSQL_DATABASE=testhub
MYSQL_USER=testhub
MYSQL_PASSWORD=testhub123
MYSQL_ROOT_PASSWORD=root123
MYSQL_HOST_PORT=53306

REDIS_PASSWORD=1234
REDIS_HOST_PORT=56379

BACKEND_HOST_PORT=58000
FRONTEND_HOST_PORT=51080

DJANGO_SETTINGS_MODULE=backend.settings_container
DEBUG=False
SECRET_KEY=testhub-fake-remote-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,testhub-frontend,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:51080,http://127.0.0.1:51080
CSRF_TRUSTED_ORIGINS=http://localhost:51080,http://127.0.0.1:51080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@testhub.local

IMPORT_INIT_SEED=1
FORCE_INIT_SEED=0
INIT_SEED_COPY_MEDIA=1
COLLECTSTATIC_ON_INIT=1
RUN_INIT_LOCATOR_STRATEGIES=1
CREATE_ADMIN_USER=1
WAIT_FOR_APP_INIT=1

CELERY_LOG_LEVEL=info
CELERY_QUEUE=celery,deployments
DEPLOYMENT_CELERY_QUEUE=deployments
CELERY_POOL=
CELERY_CONCURRENCY=

AIDEV_CELERY_LOG_LEVEL=info
AIDEV_CELERY_QUEUE=ai_coding
AIDEV_CELERY_POOL=
AIDEV_CELERY_CONCURRENCY=1
AIDEV_RUNTIME_IMAGE=testhub/ai-dev:latest

SMOKE_HOST=host.docker.internal
