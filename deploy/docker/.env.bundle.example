TZ=Asia/Shanghai
DATA_ROOT=/AIOps/data/testhub-platform
IMAGE_TAG=20260424
COMPOSE_PROJECT_NAME=testhub
CONTAINER_PREFIX=testhub
BACKEND_RUNTIME_BASE=local/testhub-platform-backend-runtime:latest
PYARMOR_VERSION=pyarmor
PYARMOR_OPTIONS=
PYARMOR_LICENSE_REQUIRED=0
PYARMOR_MAX_SCRIPT_BYTES=30000

MYSQL_DATABASE=testhub
MYSQL_USER=testhub
MYSQL_PASSWORD=testhub123
MYSQL_ROOT_PASSWORD=root123
MYSQL_HOST_PORT=13306

REDIS_PASSWORD=1234
REDIS_HOST_PORT=16379

BACKEND_HOST_PORT=38000
FRONTEND_HOST_PORT=31080
PLAYWRIGHT_RECORDER_USE_XVFB=1
PLAYWRIGHT_RECORDER_XVFB_DISPLAY=:99
PLAYWRIGHT_RECORDER_XVFB_SCREEN=1920x1080x24
PLAYWRIGHT_RECORDER_CDP_PORT=9222
PLAYWRIGHT_RECORDER_CDP_PORT_END=9262
PLAYWRIGHT_RECORDER_CDP_INTERNAL_PORT=9333
PLAYWRIGHT_RECORDER_CDP_HOST_PORT=49222
PLAYWRIGHT_RECORDER_CDP_HOST_PORT_END=49262
PLAYWRIGHT_RECORDER_DEVTOOLS_EXTERNAL_ORIGIN=http://localhost:49222
PLAYWRIGHT_RECORDER_LOCALHOST_REWRITE_HOST=host.docker.internal
PLAYWRIGHT_RECORDER_NOVNC_ENABLED=1
PLAYWRIGHT_RECORDER_VNC_PORT=5900
PLAYWRIGHT_RECORDER_NOVNC_PORT=6080
PLAYWRIGHT_RECORDER_NOVNC_PORT_END=6120
PLAYWRIGHT_RECORDER_NOVNC_HOST_PORT=46080
PLAYWRIGHT_RECORDER_NOVNC_HOST_PORT_END=46120
PLAYWRIGHT_RECORDER_NOVNC_EXTERNAL_ORIGIN=http://localhost:46080
PLAYWRIGHT_RECORDER_NOVNC_PATH=websockify
PLAYWRIGHT_RECORDER_NOVNC_RESIZE=scale
PLAYWRIGHT_RECORDER_FCITX_ENABLED=1
PLAYWRIGHT_RECORDER_MAX_SESSIONS=5
PLAYWRIGHT_RECORDER_READY_TIMEOUT=45
PLAYWRIGHT_RECORDER_CHROMIUM_LAUNCH_TIMEOUT=30000
PLAYWRIGHT_RECORDER_INITIAL_NAVIGATION_TIMEOUT=30000
PLAYWRIGHT_RECORDER_DESKTOP_READY_TIMEOUT=8
PLAYWRIGHT_RECORDER_IGNORE_HTTPS_ERRORS=1

DJANGO_SETTINGS_MODULE=backend.settings_container
DEBUG=False
ENABLE_API_DOCS=0
SECRET_KEY=change-me-before-production
ALLOWED_HOSTS=localhost,127.0.0.1,testhub-frontend
CORS_ALLOWED_ORIGINS=http://localhost:31080,http://127.0.0.1:31080
CSRF_TRUSTED_ORIGINS=http://localhost:31080,http://127.0.0.1:31080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@testhub.local

IMPORT_INIT_SEED=1
FORCE_INIT_SEED=0
INIT_SEED_COPY_MEDIA=1
COLLECTSTATIC_ON_INIT=1
RUN_INIT_LOCATOR_STRATEGIES=1
CREATE_ADMIN_USER=1

CELERY_LOG_LEVEL=info
CELERY_QUEUE=celery,deployments
DEPLOYMENT_CELERY_QUEUE=deployments
CELERY_POOL=
CELERY_CONCURRENCY=

AIDEV_CELERY_LOG_LEVEL=info
AIDEV_CELERY_QUEUE=ai_coding
AIDEV_CELERY_POOL=
AIDEV_CELERY_CONCURRENCY=1
AIDEV_RUNTIME_IMAGE=testhub/ai-dev:latest
CODEX_RUNTIME_IMAGE=local/testhub-platform-codex-runtime:latest
CLAUDE_RUNTIME_IMAGE=local/testhub-platform-claude-runtime:latest
CODEX_RUNTIME_DATA_ROOT=
CODEX_RUNTIME_VOLUME_PREFIX=testhub_codex
CODEX_RUNTIME_REMOVE_CONTAINER=1
