FROM python:3.10

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# 安装系统依赖和Playwright所需的浏览器依赖
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    vim \
    nano \
    build-essential \
    # Playwright浏览器依赖
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    fonts-liberation \
    fonts-noto-color-emoji \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    && rm -rf /var/lib/apt/lists/*

# 安装Node.js 20.x (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest \
    && rm -rf /var/lib/apt/lists/*

# 安装Python测试和开发工具
RUN pip install --no-cache-dir \
    playwright==1.40.0 \
    selenium==4.15.2 \
    pytest==7.4.3 \
    pytest-asyncio==0.21.1 \
    requests==2.31.0 \
    httpx==0.25.2 \
    python-dotenv==1.0.0 \
    pydantic==2.5.2

# 安装Playwright浏览器（仅安装chromium以减小镜像大小）
# 不使用--with-deps，因为我们已经手动安装了依赖
RUN playwright install chromium

# 创建工作目录
WORKDIR /workspace

# 设置git配置
RUN git config --global user.email "ai-dev@testhub.com" && \
    git config --global user.name "AI Developer"

# 默认命令
CMD ["tail", "-f", "/dev/null"]
