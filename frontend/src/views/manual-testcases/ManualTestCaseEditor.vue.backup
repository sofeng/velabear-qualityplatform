        <div class="color-presets">
          <h4>预设颜色</h4>
          <div class="color-grid">
            <div
              v-for="color in presetColors"
              :key="color"
              class="color-item"
              :style="{ backgroundColor: color }"
              @click="selectedColor = color"
            ></div>
