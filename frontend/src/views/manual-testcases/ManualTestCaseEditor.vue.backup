// 下载文件辅助方法
const downloadFile = (blob, filename) => {
  const url = URL.createObjectURL(blob)
  const link = document.createElement('a')
  link.href = url
  link.download = filename
  link.click()
  URL.revokeObjectURL(url)
}

// 导入命令处理
const handleImportCommand = (command) => {
  const input = document.createElement('input')
  input.type = 'file'

  switch (command) {
    case 'json':
      input.accept = '.json'
      input.onchange = importJson
      break
    case 'xmind':
      input.accept = '.xmind'
      input.onchange = importXMind
      break
    case 'markdown':
      input.accept = '.md,.markdown'
      input.onchange = importMarkdown
      break
  }

  input.click()
}

// 导入JSON
const importJson = (e) => {
  const file = e.target.files[0]
  if (!file) return

  const reader = new FileReader()
  reader.onload = (event) => {
    try {
      const data = JSON.parse(event.target.result)
      minderData.value = data
      if (minder) {
        minder.importJson(data)
      }
      ElMessage.success('导入JSON成功！')
    } catch (error) {
      console.error('导入失败:', error)
      ElMessage.error('导入失败，文件格式错误！')
    }
  }
  reader.readAsText(file)
}

// 导入Markdown
const importMarkdown = (e) => {
  const file = e.target.files[0]
  if (!file) return

  const reader = new FileReader()
  reader.onload = (event) => {
    try {
      if (minder) {
        minder.importData('markdown', event.target.result)
      }
      ElMessage.success('导入Markdown成功！')
    } catch (error) {
      console.error('导入失败:', error)
      ElMessage.error('导入失败，请检查文件格式！')
    }
  }
  reader.readAsText(file)
}

// 导入XMind
const importXMind = async (e) => {
  const file = e.target.files[0]
  if (!file) return

  try {
    ElMessage.info('正在解析XMind文件...')

    // 读取XMind文件（XMind文件是ZIP格式）
    const arrayBuffer = await file.arrayBuffer()
    const zip = await JSZip.loadAsync(arrayBuffer)

    // XMind文件包含content.xml（旧版）或content.json（新版）
    let contentData = null

    // 尝试读取content.json（XMind 2020+）
    if (zip.files['content.json']) {
      const jsonContent = await zip.files['content.json'].async('text')
      contentData = JSON.parse(jsonContent)
      const minderData = convertXMindJsonToKityMinder(contentData)

      if (minder) {
        minder.importJson(minderData)
        ElMessage.success('导入XMind成功！')
      }
    }
    // 尝试读取content.xml（XMind 8及以下）
    else if (zip.files['content.xml']) {
      const xmlContent = await zip.files['content.xml'].async('text')
      const minderData = convertXMindXmlToKityMinder(xmlContent)

      if (minder) {
        minder.importJson(minderData)
        ElMessage.success('导入XMind成功！')
      }
    } else {
      throw new Error('不支持的XMind文件格式')
    }

  } catch (error) {
    console.error('导入XMind失败:', error)
    ElMessage.error('导入XMind失败：' + error.message)
  }
}

// 转换XMind JSON格式到KityMinder格式
const convertXMindJsonToKityMinder = (xmindData) => {
  // XMind 2020+ 使用JSON格式
  const sheet = xmindData[0] // 第一个sheet
  const rootTopic = sheet.rootTopic

  const convertTopic = (topic) => {
    const node = {
      data: {
        text: topic.title || '未命名节点'
      }
    }

    // 转换标签
    if (topic.labels && topic.labels.length > 0) {
      node.data.tags = topic.labels
    }

    // 转换备注
    if (topic.notes && topic.notes.plain) {
      node.data.note = topic.notes.plain.content
    }

    // 转换优先级（XMind使用1-9，KityMinder使用0-3）
    if (topic.markers) {
      const priorityMarker = topic.markers.find(m => m.markerId && m.markerId.includes('priority'))
      if (priorityMarker) {
        const priorityNum = parseInt(priorityMarker.markerId.match(/\d+/)?.[0] || '0')
        // XMind优先级1-3映射到P0-P2
        if (priorityNum >= 1 && priorityNum <= 3) {
          node.data.priority = priorityNum - 1
        }
      }
    }

    // 递归转换子节点
    if (topic.children && topic.children.attached && topic.children.attached.length > 0) {
      node.children = topic.children.attached.map(child => convertTopic(child))
    }

    return node
  }

  return {
    root: convertTopic(rootTopic)
  }
}

// 转换XMind XML格式到KityMinder格式
const convertXMindXmlToKityMinder = (xmlString) => {
  // 解析XML
  const parser = new DOMParser()
  const xmlDoc = parser.parseFromString(xmlString, 'text/xml')

  // 查找根主题
  const rootTopic = xmlDoc.querySelector('sheet > topic')

  const convertXmlTopic = (topicElement) => {
    const node = {
      data: {
        text: topicElement.querySelector('title')?.textContent || '未命名节点'
      }
    }

    // 转换备注
    const notes = topicElement.querySelector('notes')
    if (notes) {
      const plainContent = notes.querySelector('plain')?.textContent
      if (plainContent) {
        node.data.note = plainContent
      }
    }

    // 转换标签
    const labels = topicElement.querySelectorAll('labels > label')
    if (labels.length > 0) {
      node.data.tags = Array.from(labels).map(label => label.textContent)
    }

    // 递归转换子节点
    const children = topicElement.querySelector('children[type="attached"]')
    if (children) {
      const childTopics = children.querySelectorAll(':scope > topic')
      if (childTopics.length > 0) {
        node.children = Array.from(childTopics).map(child => convertXmlTopic(child))
      }
    }

    return node
  }

  if (!rootTopic) {
    throw new Error('无效的XMind XML格式')
  }

  return {
    root: convertXmlTopic(rootTopic)
  }
}

// 当前正在编辑的输入框
let currentEditInput = null

// 创建双击编辑的输入框
const createEditInput = (node) => {
  if (!node || !minder) return

  // 如果已经有正在编辑的输入框，先保存并移除
  if (currentEditInput) {
    currentEditInput.saveAndRemove()
  }

  const box = node.getRenderBox()
  const container = document.getElementById('minder-editor')

  // 创建输入框
  const input = document.createElement('input')
  input.type = 'text'
  input.value = node.getText()
  input.className = 'km-edit-input'

  Object.assign(input.style, {
    position: 'absolute',
    left: box.x + 'px',
    top: box.y + 'px',
    width: Math.max(box.width + 20, 150) + 'px',
    height: box.height + 'px',
    fontSize: '14px',
    padding: '5px 10px',
    border: '2px solid #409eff',
    borderRadius: '4px',
    outline: 'none',
    zIndex: '9999',
    backgroundColor: 'white',
    boxShadow: '0 2px 12px rgba(0,0,0,0.1)'
  })

  let isSaved = false

  const save = () => {
    if (isSaved) return
    isSaved = true

    const newText = input.value.trim()
    if (newText && newText !== node.getText()) {
      minder.execCommand('text', newText)
      nodeText.value = newText
    }

    if (input.parentNode) {
      input.remove()
    }
    currentEditInput = null

    // 编辑完成后重新聚焦到编辑器
    setTimeout(() => {
      const editorElement = document.getElementById('minder-editor')
      if (editorElement) {
        editorElement.focus()
      }
    }, 50)
  }

  const cancel = () => {
    if (input.parentNode) {
      input.remove()
    }
    currentEditInput = null

    // 取消后重新聚焦到编辑器
    setTimeout(() => {
      const editorElement = document.getElementById('minder-editor')
      if (editorElement) {
        editorElement.focus()
      }
    }, 50)
  }

  // 保存引用和方法
  currentEditInput = {
    element: input,
    saveAndRemove: save,
    cancel: cancel
  }

  container.appendChild(input)
  input.focus()
  input.select()

  let isComposing = false

  // 监听输入法组合事件
  input.addEventListener('compositionstart', () => {
    isComposing = true
  })

  input.addEventListener('compositionend', () => {
    isComposing = false
  })

  // 按键事件
  input.addEventListener('keydown', (e) => {
    // 如果正在使用输入法组合，不处理Enter
    if (e.key === 'Enter') {
      if (!isComposing) {
        e.preventDefault()
        e.stopPropagation()
        save()
      }
    } else if (e.key === 'Escape') {
      e.preventDefault()
      e.stopPropagation()
      cancel()
    }
  })

  // 失焦时自动保存
  input.addEventListener('blur', (e) => {
    // 延迟一点点，确保焦点已经转移
    setTimeout(() => {
      if (!isSaved) {
        save()
      }
    }, 100)
  })
}

// 编辑节点（用于快捷键调用）
const editNodeInline = (node) => {
  createEditInput(node)
}

// 创建编辑输入框并智能处理输入法
const createEditInputForTypingWithIME = (node, initialChar = '') => {
  if (!node || !minder) return null

  // 如果已经有正在编辑的输入框，不再创建
  if (currentEditInput) {
    return null
  }

  const box = node.getRenderBox()
  const container = document.getElementById('minder-editor')

  // 创建输入框
  const input = document.createElement('input')
  input.type = 'text'
  input.value = initialChar // 设置初始字符
  input.className = 'km-edit-input'

  Object.assign(input.style, {
    position: 'absolute',
    left: box.x + 'px',
    top: box.y + 'px',
    width: Math.max(box.width + 20, 150) + 'px',
    height: box.height + 'px',
    fontSize: '14px',
    padding: '5px 10px',
    border: '2px solid #409eff',
    borderRadius: '4px',
    outline: 'none',
    zIndex: '9999',
    backgroundColor: 'white',
    boxShadow: '0 2px 12px rgba(0,0,0,0.1)'
  })

  let isSaved = false
  let isComposing = false

  const save = () => {
    if (isSaved) return
    isSaved = true

    const newText = input.value.trim()
    if (newText) {
      minder.execCommand('text', newText)
      nodeText.value = newText
    }

    if (input.parentNode) {
      input.remove()
    }
    currentEditInput = null

    // 编辑完成后重新聚焦到编辑器
    setTimeout(() => {
      const editorElement = document.getElementById('minder-editor')
      if (editorElement) {
        editorElement.focus()
      }
    }, 50)
  }

  const cancel = () => {
    if (input.parentNode) {
      input.remove()
    }
    currentEditInput = null

    // 取消后重新聚焦到编辑器
    setTimeout(() => {
      const editorElement = document.getElementById('minder-editor')
      if (editorElement) {
        editorElement.focus()
      }
    }, 50)
  }

  // 保存引用和方法
  currentEditInput = {
    element: input,
    saveAndRemove: save,
    cancel: cancel
  }

  container.appendChild(input)
  input.focus()
  // 将光标移到末尾
  input.setSelectionRange(input.value.length, input.value.length)

  // 监听输入法组合事件
  input.addEventListener('compositionstart', () => {
    isComposing = true
    // 不清空初始字符，保留它，让输入法自然处理
  })

  input.addEventListener('compositionend', () => {
    isComposing = false
  })

  // 按键事件
  input.addEventListener('keydown', (e) => {
    // 如果正在使用输入法组合，不处理Enter和Tab
    if (e.key === 'Enter') {
      if (!isComposing) {
        e.preventDefault()
        e.stopPropagation()
        save()
      }
    } else if (e.key === 'Tab') {
      e.preventDefault()
      e.stopPropagation()
      save()
    } else if (e.key === 'Escape') {
      e.preventDefault()
      e.stopPropagation()
      cancel()
    }
  })

  // 失焦时自动保存
  input.addEventListener('blur', (e) => {
    setTimeout(() => {
      if (!isSaved) {
        save()
      }
    }, 100)
  })

  // 返回输入框元素
  return input
}

