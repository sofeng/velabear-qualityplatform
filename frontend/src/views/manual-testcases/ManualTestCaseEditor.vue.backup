// 更新历史状态（撤销/重做）
const updateHistoryState = () => {
  if (!minder) return
  try {
    const history = minder.getHistory()
    if (history) {
      canUndo.value = history.hasUndo()
      canRedo.value = history.hasRedo()
    }
  } catch (error) {
    console.log('History not available')
  }
}

// 更新剪贴板状态
const updateClipboardState = () => {
  if (!minder) return
  try {
    const clipboard = minder.getClipboardData()
    hasClipboard.value = clipboard && clipboard.length > 0
  } catch (error) {
    console.log('Clipboard not available')
  }
}

// 加载节点数据到详情面板
const loadNodeDetails = (node) => {
  if (!node) return

  const data = getNodeData(node)

  // 基本信息
  nodeText.value = node.getText()
  currentNodeType.value = data.nodeType || ''
  currentPriority.value = data.priority !== undefined ? data.priority : null
  currentStatus.value = data.status || ''
  currentTags.value = data.tags || []

  // 详细信息
  nodeData.value = {
    caseId: data.caseId || '',
    preCondition: data.preCondition || '',
    steps: data.steps || '',
    expect: data.expect || '',
    remark: data.remark || ''
  }
}

// 初始化KityMinder
// 加载脑图数据
const loadMindmap = async (id) => {
  console.log('loadMindmap 被调用, ID:', id)
  try {
    const response = await api.get(`/testcases/manual-mindmaps/${id}/`)
    console.log('loadMindmap 成功获取数据:', response.data)
    currentMindmapId.value = response.data.id
    mindmapName.value = response.data.name
    mindmapDescription.value = response.data.description
    minderData.value = response.data.mindmap_data
    console.log('currentMindmapId 已设置为:', currentMindmapId.value)
    ElMessage.success('加载成功')
  } catch (error) {
    console.error('loadMindmap 失败:', error)
    ElMessage.error('加载失败：' + (error.response?.data?.detail || error.message))
  }
}

// 保存事件监听器引用，用于清理
let keyboardHandler = null
let editorElementRef = null

// 手动设置键盘快捷键
const setupKeyboardShortcuts = () => {
  const editorElement = document.getElementById('minder-editor')
  if (!editorElement) return

  editorElementRef = editorElement

  keyboardHandler = (e) => {
    // ========== 最高优先级：系统级按键，完全不拦截 ==========
    // 所有修饰键（Shift, Ctrl, Alt等）必须直接传递给系统
    const isModifierKey = e.key === 'Shift' || e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta' || e.key === 'CapsLock'

    // 所有输入法切换组合键必须直接传递给系统
    const isIMESwitchKey =
      (e.ctrlKey && e.key === ' ') ||           // Ctrl+Space（某些输入法）
      (e.ctrlKey && e.shiftKey) ||              // Ctrl+Shift（某些输入法）
      (e.altKey && e.shiftKey) ||               // Alt+Shift（Windows语言切换）
      e.key === 'Process'                       // IME正在处理

    // 如果是系统级按键，完全不处理，直接返回让系统接管
    if (isModifierKey || isIMESwitchKey) {
      return
    }

    // ========== 应用逻辑检查 ==========
    if (!minder) return

    const selectedNode = minder.getSelectedNode()
    if (!selectedNode) return

    const isRoot = selectedNode === minder.getRoot()

    // 方向键导航（仅在没有编辑框时）
    if (!currentEditInput && e.key === 'ArrowUp') {
      e.preventDefault()
      // 选中前一个兄弟节点
      const parent = selectedNode.parent
      if (parent) {
        const siblings = parent.children
        const currentIndex = siblings.indexOf(selectedNode)
        if (currentIndex > 0) {
          minder.select(siblings[currentIndex - 1], true)
        }
      }
      return
    }

    if (!currentEditInput && e.key === 'ArrowDown') {
      e.preventDefault()
      // 选中后一个兄弟节点
      const parent = selectedNode.parent
      if (parent) {
        const siblings = parent.children
        const currentIndex = siblings.indexOf(selectedNode)
        if (currentIndex < siblings.length - 1) {
          minder.select(siblings[currentIndex + 1], true)
        }
      }
      return
    }

    if (!currentEditInput && e.key === 'ArrowLeft') {
      e.preventDefault()
      // 选中父节点
      const parent = selectedNode.parent
      if (parent && parent !== minder.getRoot().parent) {
        minder.select(parent, true)
      }
      return
    }

    if (!currentEditInput && e.key === 'ArrowRight') {
      e.preventDefault()
      // 选中第一个子节点
      const children = selectedNode.children
      if (children && children.length > 0) {
        minder.select(children[0], true)
      }
      return
    }

    // Tab - 添加子节点（仅在没有编辑框时）
    if (!currentEditInput && e.key === 'Tab') {
      e.preventDefault()
      minder.execCommand('AppendChildNode')
      return
    }

    // Enter - 添加同级节点（仅在没有编辑框时）
    if (!currentEditInput && e.key === 'Enter' && !e.ctrlKey && !e.shiftKey) {
      e.preventDefault()
      if (!isRoot) {
        minder.execCommand('AppendSiblingNode')
      }
      return
    }

    // Delete/Backspace - 删除节点（仅在没有编辑框时）
    if ((e.key === 'Delete' || e.key === 'Backspace') && !isRoot && !currentEditInput) {
      e.preventDefault()
      minder.execCommand('RemoveNode')
      return
    }

    // F2 - 编辑节点（仅在没有编辑框时）
    if (!currentEditInput && e.key === 'F2') {
      e.preventDefault()
      editNodeInline(selectedNode)
      return
    }

    // Space - 展开/折叠（仅在没有编辑框时）
    if (e.key === ' ' && !e.ctrlKey && !currentEditInput) {
      e.preventDefault()
      const isExpanded = selectedNode.isExpanded()
      if (isExpanded) {
        minder.execCommand('Collapse')
      } else {
        minder.execCommand('Expand')
      }
      return
    }

    // Ctrl+Z - 撤销（仅在没有编辑框时，编辑框内应该撤销文本输入）
    if (!currentEditInput && e.ctrlKey && e.key === 'z') {
      e.preventDefault()
      try {
        minder.execCommand('Undo')
      } catch (err) {
        console.log('撤销不可用')
      }
      return
    }

    // Ctrl+Y - 重做（仅在没有编辑框时）
    if (!currentEditInput && e.ctrlKey && e.key === 'y') {
      e.preventDefault()
      try {
        minder.execCommand('Redo')
      } catch (err) {
        console.log('重做不可用')
      }
      return
    }

    // Ctrl+C - 复制（仅在没有编辑框时，编辑框内应该复制文本）
    if (!currentEditInput && e.ctrlKey && e.key === 'c') {
      e.preventDefault()
      try {
        minder.execCommand('Copy')
        ElMessage.success('已复制')
      } catch (err) {
        console.log('复制不可用')
      }
      return
    }

    // Ctrl+X - 剪切（仅在没有编辑框时，编辑框内应该剪切文本）
    if (!currentEditInput && e.ctrlKey && e.key === 'x' && !isRoot) {
      e.preventDefault()
      try {
        minder.execCommand('Cut')
        ElMessage.success('已剪切')
      } catch (err) {
        console.log('剪切不可用')
      }
      return
    }

    // Ctrl+V - 粘贴（仅在没有编辑框时，编辑框内应该粘贴文本）
    if (!currentEditInput && e.ctrlKey && e.key === 'v') {
      e.preventDefault()
      try {
        minder.execCommand('Paste')
        ElMessage.success('已粘贴')
      } catch (err) {
        console.log('粘贴不可用')
      }
      return
    }

    // 直接输入字符编辑节点（F2或双击也可以编辑）
    if (!currentEditInput) {
      // 排除所有组合键（Ctrl/Alt/Meta）
      if (!e.ctrlKey && !e.altKey && !e.metaKey) {
        // 普通可打印字符（排除特殊键）
        const isCharKey = (e.key.length === 1 || e.key === 'Process') &&
            e.key !== ' ' &&  // 空格键用于展开/折叠
            !/^(Shift|Control|Alt|Meta|CapsLock)$/i.test(e.key)

        if (isCharKey) {
          // 简单策略：直接创建编辑框
          // 注意：第一个字符可能无法触发中文输入法，用户需要按 F2 或双击来编辑
          e.preventDefault()
          editNodeInline(selectedNode)
          return
        }
      }
    }
  }

  // 添加键盘事件监听器
  editorElement.addEventListener('keydown', keyboardHandler)

  console.log('键盘快捷键已设置')
}

// 清理事件监听器
const cleanupEventListeners = () => {
  // 清理键盘事件监听器
  if (editorElementRef && keyboardHandler) {
    editorElementRef.removeEventListener('keydown', keyboardHandler)
    console.log('已移除键盘事件监听器')
  }

  // 清空所有引用
  keyboardHandler = null
  editorElementRef = null

  console.log('所有事件监听器已清理')
}

const initMinder = () => {
  if (!window.kityminder) {
    ElMessage.error('KityMinder库未加载，请刷新页面')
    return
  }

  try {
    const editorElement = document.getElementById('minder-editor')

    // 创建Minder实例
    minder = new window.kityminder.Minder({
      renderTo: '#minder-editor'
    })

    // 导入数据
    minder.importJson(minderData.value)

    // 设置主题和模板
    minder.execCommand('Theme', currentTheme.value)
    minder.execCommand('Template', 'default')

    // 启用编辑
    minder.enable()

    // 选中根节点
    const root = minder.getRoot()
    minder.select(root, true)

    // 居中显示
    minder.execCommand('camera', root, 600)

    // 不使用 KityMinder 的 Receiver，因为它会全局拦截键盘事件
    // 包括输入法切换键，导致在整个应用中都无法切换输入法
    // 我们使用自己的键盘事件处理，只监听特定元素，并且正确放行系统级按键
    console.log('使用自定义键盘事件监听（放行输入法切换键）')
    setupKeyboardShortcuts()

    // 聚焦到编辑器容器以确保快捷键能够工作
    setTimeout(() => {
      if (editorElement) {
        editorElement.focus()
      }
    }, 200)

    // 监听选中事件
    minder.on('selectionchange', function() {
      // 如果有正在编辑的输入框，先保存
      if (currentEditInput) {
        currentEditInput.saveAndRemove()
      }

      const node = minder.getSelectedNode()
      if (node) {
        hasSelection.value = true
        isRootSelected.value = (node === minder.getRoot())
        loadNodeDetails(node)
      } else {
        hasSelection.value = false
        isRootSelected.value = false
        nodeText.value = ''
        currentNodeType.value = ''
        currentPriority.value = null
        currentStatus.value = ''
        currentTags.value = []
        nodeData.value = {
          caseId: '',
          preCondition: '',
          steps: '',
          expect: '',
          remark: ''
        }
      }
    })

    // 监听内容变化
    minder.on('contentchange', function() {
      minderData.value = minder.exportJson()
      // 更新撤销/重做状态
      updateHistoryState()
    })

    // 监听双击编辑
    minder.on('dblclick', function() {
      const node = minder.getSelectedNode()
      if (node) {
        createEditInput(node)
      }
    })

    // 监听剪贴板变化
    minder.on('clipboardchanged', function() {
      updateClipboardState()
    })

    // 初始状态更新
    updateHistoryState()
    updateClipboardState()

    ElMessage.success('脑图加载成功！双击节点编辑，右侧面板设置属性')
  } catch (error) {
    console.error('初始化失败:', error)
    ElMessage.error('初始化失败: ' + error.message)
  }
}

onMounted(async () => {
  console.log('ManualTestCaseEditor onMounted, route.query:', route.query)
  // 如果URL中有ID参数，先设置ID并加载脑图数据
  if (route.query.id) {
    console.log('检测到 route.query.id:', route.query.id)
    // 先设置ID，确保即使加载失败也能正确更新而不是创建新脑图
    currentMindmapId.value = parseInt(route.query.id)
    console.log('currentMindmapId 预先设置为:', currentMindmapId.value)
    await loadMindmap(route.query.id)
  } else {
    console.log('未检测到 route.query.id，这是一个新脑图')
  }
  // 延迟初始化Minder以确保DOM已渲染
  setTimeout(initMinder, 100)
})

onUnmounted(() => {
  // 清理事件监听器
  cleanupEventListeners()

  // 清理正在编辑的输入框
  if (currentEditInput) {
    try {
      currentEditInput.saveAndRemove()
    } catch (e) {
      console.log('清理编辑框失败:', e)
    }
  }

  // 清理 minder 实例 - 不调用 destroy，直接清空引用
  // KityMinder 的 destroy 方法可能有问题，避免错误
  minder = null

  console.log('ManualTestCaseEditor 组件已卸载')
})
</script>

