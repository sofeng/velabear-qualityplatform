    </el-dialog>

    <!-- 字体大小对话框 -->
    <el-dialog v-model="fontSizeDialogVisible" title="设置字体大小" width="300px">
      <el-slider v-model="fontSize" :min="12" :max="48" :step="2" show-stops />
