            <el-button size="small" @click="addPresetTag('性能')">性能</el-button>
            <el-button size="small" @click="addPresetTag('安全')">安全</el-button>
          </el-button-group>
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="tagDialogVisible = false">关闭</el-button>
